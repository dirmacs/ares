[91.9, "o", "   \u001b[1m\u001b[97mAgentic Runtime Extensible Server\u001b[39m\u001b[0m \u001b[2mv0.10.0\u001b[0m\r\n\r\n  \u001b[1m\u001b[32m\u2713\u001b[39m\u001b[0m \u001b[32mConfiguration is valid!\u001b[39m\r\n\r\n\r\n  \u001b[4m\u001b[1m\u001b[97mConfiguration Summary\u001b[39m\u001b[0m\u001b[0m\r\n\r\n    \u001b[2mConfig file\u001b[0m: \u001b[97mares.toml\u001b[39m\r\n    \u001b[2mServer\u001b[0m: \u001b[97m127.0.0.1:3000\u001b[39m\r\n    \u001b[2mLog level\u001b[0m: \u001b[97minfo\u001b[39m\r\n\r\n\r\n  \u001b[1m\u001b[36mProviders\u001b[39m\u001b[0m\r\n    \u001b[34m\u2022\u001b[39m ollama-local\r\n\r\n  \u001b[1m\u001b[36mModels\u001b[39m\u001b[0m\r\n\r\n"]
