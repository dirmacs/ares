[68.2, "o", "\u001b[1;36m$\u001b[0m ares-server rag ingest-dir --collection knowledge \\\r\n    --docs-path ./missing-docs \u2026   # bad path\r\n"]
[72.7, "o", "Error: \"docs path is not a directory: ./missing-docs\"\r\n"]
[74.2, "o", "\u001b[2m   \u2192 bad input refused before any network call\u001b[0m\r\n"]
[75.1, "o", "\u001b[1;36m$\u001b[0m ares-server rag search --collection knowledge \\\r\n    --query \"rust agentic\" \u2026   # unauthenticated\r\n"]
