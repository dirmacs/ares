{"version": 2, "width": 100, "height": 32, "timestamp": 1787595918, "env": {"SHELL": null, "TERM": "dumb"}}
[0.007055, "o", "\u001b[H\u001b[2J\u001b[3J"]
[0.808534, "o", "\u001b[1m# 1. Scaffold a complete agent server in one command\u001b[0m\r\n"]
[1.609905, "o", "$ ares-server init --no-examples\r\n"]
[2.217427, "o", "\r\n\r\n  \u001b[4m\u001b[1m\u001b[97mInitializing A.R.E.S Project\u001b[39m\u001b[0m\u001b[0m\r\n\r\n  \u001b[1m\u001b[36mCreating directories\u001b[39m\u001b[0m\r\n"]
[2.217557, "o", "  \u001b[1m\u001b[32m✓\u001b[39m\u001b[0m \u001b[2mdirectory\u001b[0m \u001b[97mdata\u001b[39m\r\n  \u001b[1m\u001b[32m✓\u001b[39m\u001b[0m \u001b[2mdirectory\u001b[0m \u001b[97mconfig\u001b[39m\r\n  \u001b[1m\u001b[32m✓\u001b[39m\u001b[0m \u001b[2mdirectory\u001b[0m \u001b[97mconfig/agents\u001b[39m\r\n  \u001b[1m\u001b[32m✓\u001b[39m\u001b[0m \u001b[2mdirectory\u001b[0m \u001b[97mconfig/models\u001b[39m\r\n"]
[2.217615, "o", "  \u001b[1m\u001b[32m✓\u001b[39m\u001b[0m \u001b[2mdirectory\u001b[0m \u001b[97mconfig/tools\u001b[39m\r\n  \u001b[1m\u001b[32m✓\u001b[39m\u001b[0m \u001b[2mdirectory\u001b[0m \u001b[97mconfig/workflows\u001b[39m\r\n"]
[2.217659, "o", "  \u001b[1m\u001b[32m✓\u001b[39m\u001b[0m \u001b[2mdirectory\u001b[0m \u001b[97mconfig/mcps\u001b[39m\r\n\r\n  \u001b[1m\u001b[36mCreating configuration files\u001b[39m\u001b[0m\r\n"]
[2.217701, "o", "  \u001b[1m\u001b[32m✓\u001b[39m\u001b[0m \u001b[2mconfig\u001b[0m \u001b[97mares.toml\u001b[39m\r\n"]
[2.217742, "o", "  \u001b[1m\u001b[32m✓\u001b[39m\u001b[0m \u001b[2menv\u001b[0m \u001b[97m.env.example\u001b[39m\r\n"]
[2.217775, "o", "  \u001b[1m\u001b[32m✓\u001b[39m\u001b[0m \u001b[2mfile\u001b[0m \u001b[97m.gitignore\u001b[39m\r\n\r\n  \u001b[32m🚀\u001b[39m \u001b[1m\u001b[92mA.R.E.S project initialized successfully!\u001b[39m\u001b[0m\r\n\r\n  \u001b[4m\u001b[1m\u001b[97mNext Steps\u001b[39m\u001b[0m\u001b[0m\r\n\r\n  \u001b[34m•\u001b[39m 1. Set up environment variables:\r\n     \u001b[96m$ cp .env.example .env\u001b[39m\r\n     \u001b[96m$ # Edit .env and set JWT_SECRET (min 32 chars) and API_KEY\u001b[39m\r\n\r\n  \u001b[34m•\u001b[39m 2. Start Ollama (if not running):\r\n     \u001b[96m$ ollama serve\u001b[39m\r\n     \u001b[96m$ ollama pull ministral-3:3b  # or your preferred model\u001b[39m\r\n\r\n  \u001b[34m•\u001b[39m 3. Start the server:\r\n     \u001b[96m$ ares-server\u001b[39m\r\n\r\n\r\n  \u001b[2m💡\u001b[0m \u001b[3m\u001b[2mServer will be available at http://127.0.0.1:3000\u001b[0m\u001b[0m\r\n\r\n  \u001b[2m💡\u001b[0m \u001b[3m\u001b[2mAPI docs available at /swagger-ui/ (requires 'swagger-ui' feature)\u001b[0m\u001b[0m\r\n\r\n  \u001b[2m💡\u001b[0m \u001b[3m\u001b[2mBuild with: cargo build --features swagger-ui\u001b[0m\u001b[0m\r\n"]
[4.419277, "o", "\r\n\u001b[1m# What just appeared on disk:\u001b[0m\r\n"]
[5.221759, "o", "config\r\n├── agents\r\n├── mcps\r\n"]
[5.22179, "o", "├── models\r\n├── tools\r\n"]
[5.221798, "o", "└── workflows\r\n"]
[5.221879, "o", "data\r\n\r\n6 directories, 0 files\r\n"]
[5.223237, "o", "ares.toml\r\n"]
[7.824435, "o", "\r\n\u001b[1m# 2. Inspect the generated configuration\u001b[0m\r\n"]
[8.625884, "o", "$ ares-server config\r\n"]
[9.234337, "o", "\r\n  \u001b[4m\u001b[1m\u001b[97mConfiguration Summary\u001b[39m\u001b[0m\u001b[0m\r\n\r\n    \u001b[2mConfig file\u001b[0m: \u001b[97mares.toml\u001b[39m\r\n    \u001b[2mServer\u001b[0m: \u001b[97m127.0.0.1:3000\u001b[39m\r\n    \u001b[2mLog level\u001b[0m: \u001b[97minfo\u001b[39m\r\n\r\n\r\n  \u001b[1m\u001b[36mProviders\u001b[39m\u001b[0m\r\n    \u001b[34m•\u001b[39m ollama-local\r\n\r\n  \u001b[1m\u001b[36mModels\u001b[39m\u001b[0m\r\n\r\n  \u001b[1m\u001b[36mAgents\u001b[39m\u001b[0m\r\n    \u001b[34m•\u001b[39m orchestrator\r\n    \u001b[34m•\u001b[39m router\r\n\r\n  \u001b[1m\u001b[36mTools\u001b[39m\u001b[0m\r\n"]
[9.234366, "o", "    \u001b[34m•\u001b[39m web_search\r\n    \u001b[34m•\u001b[39m calculator\r\n"]
[11.636011, "o", "\r\n\u001b[1m# 3. Validate before you boot — fail fast, not at runtime\u001b[0m\r\n"]
[12.437405, "o", "$ ares-server config --validate\r\n"]
[13.046241, "o", "  \u001b[1m\u001b[32m✓\u001b[39m\u001b[0m \u001b[32mConfiguration is valid!\u001b[39m\r\n"]
[15.047575, "o", "\r\n\u001b[1m# 4. Your agent fleet, straight from TOML\u001b[0m\r\n"]
[15.848927, "o", "$ ares-server agent list\r\n"]
[16.457696, "o", "\r\n  \u001b[4m\u001b[1m\u001b[97mConfigured Agents\u001b[39m\u001b[0m\u001b[0m\r\n\r\n    \u001b[1m\u001b[97mName            Model           Tools          \u001b[39m\u001b[0m\r\n    \u001b[2m────────────────────────────────────────────────\u001b[0m\r\n    orchestrator    meta/llama-3.3-70b-instruct calculator, web_search\r\n    router          meta/llama-3.3-70b-instruct -              \r\n"]
[18.859557, "o", "\r\n$ ares-server agent show router\r\n"]
[19.46838, "o", "\r\n  \u001b[4m\u001b[1m\u001b[97mAgent: router\u001b[39m\u001b[0m\u001b[0m\r\n\r\n    \u001b[2mModel\u001b[0m: \u001b[97mmeta/llama-3.3-70b-instruct\u001b[39m\r\n    \u001b[2mMax tool iterations\u001b[0m: \u001b[97m1\u001b[39m\r\n    \u001b[2mParallel tools\u001b[0m: \u001b[97mfalse\u001b[39m\r\n\r\n  \u001b[1m\u001b[36mSystem Prompt\u001b[39m\u001b[0m\r\nYou are a routing agent that classifies user queries.\r\n\r\nAvailable agents:\r\n- orchestrator: General purpose agent for complex queries\r\n\r\nRespond with ONLY the agent name (one word, lowercase).\r\n\r\n"]
[22.070031, "o", "\r\n\u001b[1m# 5. One binary, many modes\u001b[0m\r\n"]
[22.871566, "o", "$ ares-server          # full HTTP API server (Axum)\r\n"]
[23.572911, "o", "$ ares-server --mcp    # MCP stdio server for Claude Desktop / Cursor / any MCP host\r\n"]
[24.274229, "o", "$ use ares_server::…   # embed as a Rust library — same Context, no HTTP stack\r\n"]
[26.875544, "o", "\r\n\u001b[2mARES — Agentic Runtime Extensible Server · built on the Cordis kernel · crates.io: ares-server\u001b[0m\r\n"]
