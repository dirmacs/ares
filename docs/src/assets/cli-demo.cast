[54.5, "o", "   \u001b[1m\u001b[97mAgentic Runtime Extensible Server\u001b[39m\u001b[0m \u001b[2mv0.10.0\u001b[0m\r\n\r\n\r\n  \u001b[4m\u001b[1m\u001b[97mAgent: router\u001b[39m\u001b[0m\u001b[0m\r\n\r\n    \u001b[2mModel\u001b[0m: \u001b[97mmeta/llama-3.3-70b-instruct\u001b[39m\r\n    \u001b[2mMax tool iterations\u001b[0m: \u001b[97m1\u001b[39m\r\n    \u001b[2mParallel tools\u001b[0m: \u001b[97mfalse\u001b[39m\r\n\r\n  \u001b[1m\u001b[36mSystem Prompt\u001b[39m\u001b[0m\r\nYou are a routing agent that classifies user queries.\r\n"]
