[17.1, "o", "   \u001b[1m\u001b[97mAgentic Runtime Extensible Server\u001b[39m\u001b[0m \u001b[2mv0.10.0\u001b[0m\r\n\r\n\r\n  \u001b[4m\u001b[1m\u001b[97mInitializing A.R.E.S Project\u001b[39m\u001b[0m\u001b[0m\r\n\r\n  \u001b[1m\u001b[36mCreating directories\u001b[39m\u001b[0m\r\n  \u001b[1m\u001b[32m\u2713\u001b[39m\u001b[0m \u001b[2mdirectory\u001b[0m \u001b[97mdata\u001b[39m\r\n  \u001b[1m\u001b[32m\u2713\u001b[39m\u001b[0m \u001b[2mdirectory\u001b[0m \u001b[97mconfig\u001b[39m\r\n  \u001b[1m\u001b[32m\u2713\u001b[39m\u001b[0m \u001b[2mdirectory\u001b[0m \u001b[97mconfig/agents\u001b[39m\r\n  \u001b[1m\u001b[32m\u2713\u001b[39m\u001b[0m \u001b[2mdirectory\u001b[0m \u001b[97mconfig/models\u001b[39m\r\n  \u001b[1m\u001b[32m\u2713\u001b[39m\u001b[0m \u001b[2mdirectory\u001b[0m \u001b[97mconfig/tools\u001b[39m\r\n  \u001b[1m\u001b[32m\u2713\u001b[39m\u001b[0m \u001b[2mdirectory\u001b[0m \u001b[97mconfig/workflows\u001b[39m\r\n  \u001b[1m\u001b[32m\u2713\u001b[39m\u001b[0m \u001b[2mdirectory\u001b[0m \u001b[97mconfig/mcps\u001b[39m\r\n\r\n  \u001b[1m\u001b[36mCreating configuration files\u001b[39m\u001b[0m\r\n  \u001b[1m\u001b[32m\u2713\u001b[39m\u001b[0m \u001b[2mconfig\u001b[0m \u001b[97mares.toml\u001b[39m\r\n  \u001b[1m\u001b[32m\u2713\u001b[39m\u001b[0m \u001b[2menv\u001b[0m \u001b[97m.env.example\u001b[39m\r\n\r\n  \u001b[1m\u001b[36mCreating example configurations\u001b[39m\u001b[0m\r\n  \u001b[1m\u001b[32m\u2713\u001b[39m\u001b[0m \u001b[2mmodel\u001b[0m \u001b[97mconfig/models/fast.toon\u001b[39m\r\n  \u001b[1m\u001b[32m\u2713\u001b[39m\u001b[0m \u001b[2mmodel\u001b[0m \u001b[97mconfig/models/balanced.toon\u001b[39m\r\n  \u001b[1m\u001b[32m\u2713\u001b[39m\u001b[0m \u001b[2mmodel\u001b[0m \u001b[97mconfig/models/powerful.toon\u001b[39m\r\n  \u001b[1m\u001b[32m\u2713\u001b[39m\u001b[0m \u001b[2magent\u001b[0m \u001b[97mconfig/agents/router.toon\u001b[39m\r\n  \u001b[1m\u001b[32m\u2713\u001b[39m\u001b[0m \u001b[2magent\u001b[0m \u001b[97mconfig/agents/orchestrator.toon\u001b[39m\r\n"]
[18.6, "o", "\u001b[2m   \u2192 one command scaffolds config, agents, models, tools\u001b[0m\r\n"]
[19.5, "o", "\u001b[1;36m$\u001b[0m find . -type f | sort\r\n"]
[24.0, "o", "./.env.example\r\n./.gitignore\r\n./ares.toml\r\n./config/agents/orchestrator.toon\r\n./config/agents/router.toon\r\n./config/models/balanced.toon\r\n./config/models/fast.toon\r\n./config/models/powerful.toon\r\n./config/tools/calculator.toon\r\n./config/tools/web_search.toon\r\n"]
