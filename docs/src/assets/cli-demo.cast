[81.1, "o", "\u001b[2m   \u2192 fails closed \u2014 HTTP 401, nothing half-served\u001b[0m\r\n"]
[82.0, "o", "\u001b[1;36m$\u001b[0m sed 's/port = 3000/port = \"not-a-number\"/' ares.toml > broken.toml\r\n$ ares-server config --validate -c broken.toml\r\n"]
[86.5, "o", "   \u001b[1m\u001b[97mAgentic Runtime Extensible Server\u001b[39m\u001b[0m \u001b[2mv0.10.0\u001b[0m\r\n\r\nError: ParseError(Error { message: \"invalid type: string \\\"not-a-number\\\", expected u16\", input\u2026\r\n"]
