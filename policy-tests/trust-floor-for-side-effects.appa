# A mutating call requires trusted data. The trajectory starts trusted, the
# suspicious read drops it, and every later mutating call is denied.
host/ares/apply_change {
  change: "the first one"
}
expect allow

host/ares/read_ticket {
  ticket: "acme-2"
}
expect allow

host/ares/apply_change {
  change: "after the suspicious read"
}
expect deny

host/ares/apply_change {
  change: "still denied"
}
expect deny
